      "view-ng-node": {
        "url": "https://github.com/kkgams/view.ng-node/releases/download/v0.1.0/view.ng-node-0.1.0.zip#views/view-ng-node.js",
        "label": "Node Editor",
        "internal": true,
        "config": {
          "presets": [
            {
              "name": "Read Text",
              "kind": "code",
              "codePath": "ng/presets/read-text.lua",
              "inputs": [
                {
                  "name": "path",
                  "defaultValue": ""
                }
              ],
              "outputs": [
                {
                  "name": "text"
                }
              ],
              "group": "Files"
            },
            {
              "name": "Ensure Directory",
              "kind": "code",
              "codePath": "ng/presets/ensure-directory.lua",
              "inputs": [
                {
                  "name": "directory",
                  "defaultValue": "build.nosync"
                },
                {
                  "name": "value",
                  "defaultValue": ""
                }
              ],
              "outputs": [
                {
                  "name": "value"
                }
              ],
              "group": "Files"
            },
            {
              "name": "Director Compile",
              "kind": "code",
              "codePath": "ng/presets/director-compile.lua",
              "inputs": [
                {
                  "name": "source",
                  "defaultValue": ""
                }
              ],
              "outputs": [
                {
                  "name": "data"
                },
                {
                  "name": "symbols"
                }
              ],
              "group": "Station"
            },
            {
              "name": "Station Bindings",
              "kind": "code",
              "codePath": "ng/presets/station-bindings.lua",
              "inputs": [
                {
                  "name": "symbols",
                  "defaultValue": ""
                }
              ],
              "outputs": [
                {
                  "name": "bindings"
                }
              ],
              "group": "Station"
            },
            {
              "name": "Respack Content Save",
              "kind": "code",
              "codePath": "ng/presets/respack-content-save.lua",
              "inputs": [
                {
                  "name": "schema",
                  "defaultValue": ""
                },
                {
                  "name": "Director IR",
                  "defaultValue": ""
                },
                {
                  "name": "bindings",
                  "defaultValue": ""
                },
                {
                  "name": "output path",
                  "defaultValue": "build.nosync/station.rspk"
                }
              ],
              "outputs": [
                {
                  "name": "byte count"
                }
              ],
              "group": "Station"
            },
            {
              "name": "Export Station Web",
              "kind": "code",
              "codePath": "ng/presets/export-station-web.lua",
              "inputs": [
                {
                  "name": "pack byte count"
                },
                {
                  "name": "output directory",
                  "defaultValue": "export/web"
                },
                {
                  "name": "index source",
                  "defaultValue": "game/build.nosync/web/index.html"
                },
                {
                  "name": "GL bridge source",
                  "defaultValue": "game/build.nosync/web/gl-bridge.js"
                },
                {
                  "name": "WASM source",
                  "defaultValue": "game/build.nosync/web/station-demo.wasm"
                },
                {
                  "name": "content pack source",
                  "defaultValue": "build.nosync/station.rspk"
                }
              ],
              "outputs": [
                {
                  "name": "export"
                }
              ],
              "group": "Station"
            }
          ]
        }
      },
      "files-rename": {
        "url": "https://github.com/kkgams/view.files-rename/releases/download/v0.1.0/view.files-rename-0.1.0.zip#views/files-rename.js",
        "label": "Rename File",
        "internal": true
      },
      "files-default": {
        "url": "https://github.com/kkgams/view.files-default/releases/download/v0.1.0/view.files-default-0.1.0.zip#views/files-default.js",
