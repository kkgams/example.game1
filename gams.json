{
  "plugins": [
    "https://github.com/kkgams/plugin.layout/releases/download/v0.1.0/plugin.layout.wasm",
    "https://github.com/kkgams/plugin.lua/releases/download/v0.1.0/plugin.lua.wasm",
    "https://github.com/kkgams/plugin.director-compiler/releases/download/v0.1.0/director-compiler.wasm",
    "https://github.com/kkgams/plugin.respack/releases/download/v0.1.0/plugin.respack.wasm"
  ],
  "ui": {
    "keys": [
      {
        "key": "mod+alt+s",
        "call": ["project.save"],
        "allowInput": true
      },
      {
        "key": "mod+s",
        "call": [
          "activeView.save"
        ],
        "allowInput": true
      },
      {
        "key": "mod+enter",
        "call": [
          "activeView.run"
        ],
        "allowInput": false
      }
    ],
    "theme": {
      "url": "https://github.com/kkgams/theme.the98/releases/download/v0.1.0/theme.the98-0.1.0.zip#themes/the98.css"
    },
    "services": {
      "ui-context": {
        "url": "https://github.com/kkgams/ui-service.context/releases/download/v0.1.0/ui-service.context-0.1.0.zip#ui-plugins/context.js"
      },
      "ui-keys": {
        "url": "https://github.com/kkgams/ui-service.keys/releases/download/v0.1.0/ui-service.keys-0.1.0.zip#ui-plugins/keys.js"
      },
      "ui-toast": {
        "url": "https://github.com/kkgams/ui-service.toast/releases/download/v0.1.0/ui-service.toast-0.1.0.zip#ui-plugins/toast.js"
      },
      "ui-popup": {
        "url": "https://github.com/kkgams/ui-service.popup/releases/download/v0.1.0/ui-service.popup-0.1.0.zip#ui-plugins/popup.js"
      },
      "ui-tooltip": {
        "url": "https://github.com/kkgams/ui-service.tooltip/releases/download/v0.1.0/ui-service.tooltip-0.1.0.zip#ui-plugins/tooltip.js"
      },
      "ui-layout": {
        "url": "https://github.com/kkgams/ui-service.layout/releases/download/v0.1.0/ui-service.layout-0.1.0.zip#ui-plugins/layout.js",
        "config": {
          "layout": "<view-files data-root=\".\" /><view-code setup=\"0:h:65\" data-source=\"content/power.director\" /><view-ng setup=\"1:v:55\" data-source=\"build.ng.json\" />"
        }
      }
    },
    "views": {
      "view-files": {
        "url": "https://github.com/kkgams/view.files/releases/download/v0.1.0/view.files-0.1.0.zip#views/view-files.js",
        "label": "Files",
        "group": "Project",
        "internal": false,
        "config": {
          "open": {
            "build.ng.json": "view-ng",
            "director": "view-code",
            "json": "view-code",
            "lua": "view-code",
            "md": "view-code",
            "default": "files-default"
          }
        }
      },
      "view-code": {
        "url": "https://github.com/kkgams/view.code/releases/download/v0.1.0/view.code-0.1.0.zip#views/view-code.js",
        "label": "Code",
        "internal": true
      },
      "view-ng": {
        "url": "https://github.com/kkgams/view.ng/releases/download/v0.1.0/view.ng-0.1.0.zip#views/view-ng.js",
        "label": "Build & Export",
        "group": "Project",
        "internal": false,
        "defaultSource": "build.ng.json",
        "config": {
